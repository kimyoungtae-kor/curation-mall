# Copy this file to .env for local development.
# Never reuse these example values in stage or production.

POSTGRES_DB=pet_curation
POSTGRES_USER=pet_app
POSTGRES_PASSWORD=replace_with_local_only_password
POSTGRES_PORT=5432

SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pet_curation
SPRING_DATASOURCE_USERNAME=pet_app
SPRING_DATASOURCE_PASSWORD=replace_with_local_only_password
GUEST_LOOKUP_TOKEN_SECRET=replace_with_at_least_32_random_bytes_for_local_only

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

MEDIA_STORAGE_ROOT=../media
MEDIA_PUBLIC_CACHE_MAX_AGE=1h
