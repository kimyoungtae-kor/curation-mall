limit_req_zone $binary_remote_addr zone=authentication:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=guest_lookup:10m rate=20r/m;
limit_req_status 429;
limit_req_log_level warn;

upstream pet_backend {
    server backend:8080;
    keepalive 16;
}

upstream pet_frontend {
    server frontend:3000;
    keepalive 16;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${APP_DOMAIN} ${APP_WWW_DOMAIN} ${LEGACY_APP_DOMAIN};

    server_tokens off;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${APP_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_WWW_DOMAIN};

    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    return 301 https://${APP_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${LEGACY_APP_DOMAIN};

    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${LEGACY_APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${LEGACY_APP_DOMAIN}/privkey.pem;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    return 301 https://${APP_DOMAIN}$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${APP_DOMAIN};

    server_tokens off;
    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_set_header Connection "";
    proxy_set_header Host ${APP_DOMAIN};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host ${APP_DOMAIN};
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-Proto https;

    ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api/v1/auth/login {
        limit_req zone=authentication burst=5 nodelay;
        proxy_pass http://pet_backend;
    }

    location = /api/v1/auth/signup {
        limit_req zone=authentication burst=5 nodelay;
        proxy_pass http://pet_backend;
    }

    location = /api/v1/guest-orders/lookup {
        limit_req zone=guest_lookup burst=10 nodelay;
        proxy_pass http://pet_backend;
    }

    location /api/ {
        proxy_pass http://pet_backend;
    }

    location /media/ {
        proxy_pass http://pet_backend;
    }

    location / {
        proxy_pass http://pet_frontend;
        proxy_buffering off;
    }
}
