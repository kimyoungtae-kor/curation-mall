# EC2 stage deployment only. Copy to .env.deploy and never commit the copy.
COMPOSE_PROJECT_NAME=pet-curation

# Canonical public HTTPS host and redirect-only aliases.
# Use hostnames only: no https:// prefix and no path.
APP_DOMAIN=shop.example.com
APP_WWW_DOMAIN=www.shop.example.com
LEGACY_APP_DOMAIN=legacy-shop.example.com
CERTBOT_EMAIL=owner@example.com

# Generate both secrets separately with: openssl rand -hex 32
POSTGRES_DB=pet_curation
POSTGRES_USER=pet_app
POSTGRES_PASSWORD=replace_with_a_unique_64_character_hex_value
GUEST_LOOKUP_TOKEN_SECRET=replace_with_a_different_unique_64_character_hex_value

# Required persistent media directory on the deployment host. Keep it outside
# the Git checkout and prepare it for the backend UID/GID 10001 before deploy.
MEDIA_HOST_PATH=/var/lib/pet-curation/media

# Optional overrides. The compose file otherwise uses these defaults.
MEDIA_PUBLIC_CACHE_MAX_AGE=1h
BACKEND_IMAGE=pet-curation-backend:local
FRONTEND_IMAGE=pet-curation-frontend:local
